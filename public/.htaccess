   <IfModule mod_rewrite.c>
     RewriteEngine On
     RewriteCond %{HTTPS} off [OR]
     RewriteCond %{HTTP_HOST} ^www\. [NC]
     RewriteRule ^(.*)$ https://primefix.vip/$1 [R=301,L]
   </IfModule>

# --- Single-page-app routing -------------------------------------------------
# Client-side routes (/reviews, /faq, ...) don't exist as files, so serve
# index.html for anything that isn't a real file or directory. Real files
# (including /api/*.php when the PHP backend lives in /api) pass straight through.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# --- Security headers -------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Compression + caching ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # Vite fingerprints everything in /assets, so it can be cached "forever".
  <FilesMatch "\.(js|css|webp|png|jpg|svg|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # But never cache the entry points / service worker, or updates won't reach visitors.
  <FilesMatch "(index\.html|sw\.js|manifest\.webmanifest|workbox-.*\.js)$">
    ExpiresDefault "access plus 0 seconds"
    <IfModule mod_headers.c>
      Header set Cache-Control "no-cache"
    </IfModule>
  </FilesMatch>
</IfModule>
