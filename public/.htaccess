   <IfModule mod_rewrite.c>
     RewriteEngine On
     RewriteCond %{HTTPS} off [OR]
     RewriteCond %{HTTP_HOST} ^www\. [NC]
     RewriteRule ^(.*)$ https://primefix.vip/$1 [R=301,L]
   </IfModule>

# --- Prerendered pages ---------------------------------------------------------
# Every page is built as a real file (/services/roofing/index.html, ...). The web server serves it at /services/roofing/
# by itself (and adds the trailing slash for you), so no rewrite rules are needed here.

# Unknown URLs get a real 404 status with the branded not-found page (no more "everything returns the home page").
ErrorDocument 404 /404.html
Options -Indexes

# --- Security headers -------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# --- Compression + caching ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # Vite fingerprints everything in /assets, so it can be cached "forever".
  <FilesMatch "\.(js|css|webp|png|jpg|svg|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # But never cache the pages, service worker or manifest, or updates won't reach visitors.
  <FilesMatch "(index\.html|404\.html|sw\.js|manifest\.webmanifest|workbox-.*\.js)$">
    ExpiresDefault "access plus 0 seconds"
    <IfModule mod_headers.c>
      Header set Cache-Control "no-cache"
    </IfModule>
  </FilesMatch>
</IfModule>
