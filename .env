# Copy to .env (git-ignored). Vite bakes this in at BUILD time.

# Where the PHP endpoints (send-mail.php, subscribe.php, submit-review.php) live.
#   Local dev ............ /api  (vite.config.js proxies it to `php -S localhost:8000`)
#   Same domain in prod .. /api  (upload the server/ folder as public_html/api/)
#   Separate host ........ https://api.yourdomain.com  (also set ALLOWED_ORIGIN in server/.env)
VITE_API_BASE=/api
