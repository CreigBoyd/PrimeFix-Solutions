# Copy to server/.env and fill in. server/.env is git-ignored and blocked by .htaccess.
# On production hosts you can set these as real environment variables instead.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-account@gmail.com
# Gmail: Google Account > Security > 2-Step Verification > App passwords
SMTP_PASS=
# Optional: defaults to SMTP_USER
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PrimeFix Solutions
# Optional: defaults to SMTP_USER
NOTIFY_TO_EMAIL=
BUSINESS_PHONE=(555) 010-2000

# Only needed if the website and this API are on DIFFERENT domains.
# ALLOWED_ORIGIN=https://primefix.vip

# Only set to true behind a trusted proxy/CDN (Cloudflare etc.)
# TRUST_PROXY=false
