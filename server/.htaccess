# Block direct access to private files (works on Apache 2.2 and 2.4).
<FilesMatch "(^\.env|\.(json|csv|log|lock|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
